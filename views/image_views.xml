<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Used from the Images page of a SKU or a task, where the SKU is set automatically. -->
    <record id="urbana_sku_image_view_form" model="ir.ui.view">
        <field name="name">urbana.sku.image.form</field>
        <field name="model">urbana.sku.image</field>
        <field name="arch" type="xml">
            <form string="Image">
                <group>
                    <field name="name" placeholder="What does this show?"/>
                    <field name="task_id" options="{'no_create': True}"/>
                    <field name="image" widget="image" options="{'preview_image': 'image'}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="urbana_sku_image_view_kanban" model="ir.ui.view">
        <field name="name">urbana.sku.image.kanban</field>
        <field name="model">urbana.sku.image</field>
        <field name="arch" type="xml">
            <kanban string="Images">
                <field name="name"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <field name="image" widget="image" options="{'zoom': true, 'preview_image': 'image'}"/>
                        <div class="p-2">
                            <field name="name" class="fw-bold d-block text-truncate"/>
                            <field name="stage_id" class="text-muted small"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
