<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="urbana_task_view_form" model="ir.ui.view">
        <field name="name">project.task.form.urbana</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_review" invisible="1"/>
                <field name="is_current_stage" invisible="1"/>
                <field name="project_is_last_stage" invisible="1"/>
                <button name="action_open_handover_wizard" type="object" string="Hand Over"
                        class="btn-primary"
                        invisible="not is_current_stage or state == '1_done' or project_is_last_stage"/>
                <button name="action_approve" type="object" string="Approve" class="btn-primary"
                        groups="urbana_sku_pipeline.group_urbana_reviewer,project.group_project_manager"
                        invisible="not can_review"/>
                <button name="action_request_changes" type="object" string="Send Back"
                        groups="urbana_sku_pipeline.group_urbana_reviewer,project.group_project_manager"
                        invisible="not is_current_stage or state == '1_done'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="SKU Pipeline" invisible="not pipeline_stage_id">
                    <group>
                        <field name="pipeline_stage_id"/>
                        <field name="output_url" widget="url"/>
                        <field name="hubstaff_task_id" groups="project.group_project_manager"/>
                    </group>
                    <group>
                        <field name="is_approved"/>
                        <field name="approved_by"/>
                        <field name="approved_date"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
