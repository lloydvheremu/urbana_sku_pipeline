<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="urbana_sku_handover_view_list" model="ir.ui.view">
        <field name="name">urbana.sku.handover.list</field>
        <field name="model">urbana.sku.handover</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="project_id"/>
                <field name="from_stage_id"/>
                <field name="to_stage_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <field name="is_send_back"/>
                <field name="hours_snapshot" widget="float_time"/>
                <field name="notes"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="urbana_sku_handover_view_search" model="ir.ui.view">
        <field name="name">urbana.sku.handover.search</field>
        <field name="model">urbana.sku.handover</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id"/>
                <filter name="send_backs" string="Send Backs" domain="[('is_send_back', '=', True)]"/>
                <group>
                    <filter name="group_project" string="SKU" context="{'group_by': 'project_id'}"/>
                    <filter name="group_to" string="To Stage" context="{'group_by': 'to_stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="urbana_sku_handover_action" model="ir.actions.act_window">
        <field name="name">Handovers</field>
        <field name="res_model">urbana.sku.handover</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
