<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_urbana_pipeline" model="res.groups.privilege">
        <field name="name">SKU Pipeline</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_urbana_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="comment">Can approve stages and send SKUs back.</field>
        <field name="privilege_id" ref="res_groups_privilege_urbana_pipeline"/>
        <field name="implied_ids" eval="[
            (4, ref('project.group_project_user')),
            (4, ref('hr_timesheet.group_hr_timesheet_user')),
        ]"/>
    </record>

    <!-- Handovers follow the visibility of the project they belong to. -->
    <record id="urbana_sku_handover_project_visibility" model="ir.rule">
        <field name="name">SKU handover: follow project visibility</field>
        <field name="model_id" ref="model_urbana_sku_handover"/>
        <field name="domain_force">[('project_id', 'any', [])]</field>
    </record>
</odoo>
